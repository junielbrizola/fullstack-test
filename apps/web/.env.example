# Base URLs only. The client adds /api/v1 to API requests.
# Use the Compose service name for server-side calls in Docker.
API_INTERNAL_BASE_URL=http://api:8080

# Browser requests need a host-resolvable URL and API CORS permission.
API_PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_BUSINESS_TIME_ZONE=America/Sao_Paulo
